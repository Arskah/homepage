{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:js-app",
    "docker:enableMajor",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    ":automergeRequireAllStatusChecks",
    ":dependencyDashboard",
    ":label(dependencies)",
    ":maintainLockFilesWeekly",
    "security:minimumReleaseAgeNpm",
    ":disableRateLimiting"
  ],
  "kubernetes": {
    "managerFilePatterns": ["/k8s/*/"]
  },
  "timezone": "Europe/Helsinki",
  "postUpdateOptions": ["pnpmDedupe"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "enabled": false,
      "pinDigests": false,
      "matchPackageNames": ["/^forge.aarnihalinen.fi/public/homepage/"]
    },
    {
      "groupName": "playwright",
      "groupSlug": "playwright",
      "matchPackageNames": [
        "/^mcr.microsoft.com/playwright/",
        "/@playwright/test/"
      ]
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Renovate version that validates this config in the lint workflow",
      "managerFilePatterns": ["/^\\.github/workflows/lint\\.yml$/"],
      "matchStrings": ["npx --yes --package renovate@(?<currentValue>\\S+)"],
      "depNameTemplate": "renovate",
      "datasourceTemplate": "npm"
    }
  ]
}
