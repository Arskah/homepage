{
	# Plain HTTP behind the TLS proxy: no certificates, no admin API
	admin off
	persist_config off
	auto_https off
}

:80 {
	root * /srv
	encode gzip

	# Revalidate everything by default: without Cache-Control browsers guess a
	# freshness lifetime from Last-Modified and keep serving stale pages after a
	# release. ETag keeps the revalidation a cheap 304.
	header ?Cache-Control "no-cache"

	# Build assets carry a content hash in their name, so they never change.
	# stylex.css is the exception: unplugin-stylex emits it under a fixed name.
	@hashed {
		path /_astro/*
		not path /_astro/stylex.css
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# A directory URL without its trailing slash gets a redirect with a relative
	# Location, so it keeps the https scheme of the visitor's request although
	# TLS ends at the proxy in front.
	file_server
}
