---
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-600.css";
import "modern-normalize/modern-normalize.css";

import "../styles/global.css";

import { ClientRouter } from "astro:transitions";

interface Props {
  description: string;
  image?: string;
  title: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { description, image, title } = Astro.props;
---

<!--
  unplugin-stylex only adds its stylesheet from a runtime script. A real link
  keeps it across client-side navigations (the router drops head elements the
  next page does not declare), makes it render-blocking, and works without
  JavaScript. The path is the plugin's default output file.
-->
<link href="/_astro/stylex.css" rel="stylesheet" />

<ClientRouter />

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta content="width=device-width,initial-scale=1" name="viewport" />
<link href="/favicon.svg" rel="icon" type="image/svg+xml" />
<meta content={Astro.generator} name="generator" />

<!--
  Apply a stored theme choice before first paint, so a reload does not flash
  the system color scheme. Without a stored choice the system one is used.
-->
<script is:inline>
  const applyStoredTheme = () => {
    try {
      const theme = localStorage.getItem("theme");
      if (theme === "light" || theme === "dark") {
        document.documentElement.dataset.theme = theme;
      }
    } catch {
      // Storage unavailable: follow the system color scheme.
    }
  };
  applyStoredTheme();
  // The client router replaces the attributes of <html> on every navigation.
  document.addEventListener("astro:after-swap", applyStoredTheme);
</script>

<!-- Font preloads -->
<link
  as="font"
  crossorigin
  href="/fonts/atkinson-regular.woff"
  rel="preload"
  type="font/woff"
/>
<link
  as="font"
  crossorigin
  href="/fonts/atkinson-bold.woff"
  rel="preload"
  type="font/woff"
/>

<!-- Canonical URL -->
<link href={canonicalURL} rel="canonical" />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta content={title} name="title" />
<meta content={description} name="description" />

<!-- Open Graph / Facebook -->
<meta content="website" property="og:type" />
<meta content={Astro.url} property="og:url" />
<meta content={title} property="og:title" />
<meta content={description} property="og:description" />
{image && <meta content={new URL(image, Astro.url)} property="og:image" />}

<!-- Twitter -->
<meta
  content={image ? "summary_large_image" : "summary"}
  property="twitter:card"
/>
<meta content={Astro.url} property="twitter:url" />
<meta content={title} property="twitter:title" />
<meta content={description} property="twitter:description" />
{image && <meta content={new URL(image, Astro.url)} property="twitter:image" />}
