---
import * as stylex from "@stylexjs/stylex";

import { SITE_TITLE } from "../consts";
import { styles } from "./Header.stylex";
import HeaderLink from "./HeaderLink.astro";
import LifeToggle from "./LifeToggle.astro";
import SocialLinks from "./SocialLinks.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header {...stylex.attrs(styles.header)}>
  <nav {...stylex.attrs(styles.nav)}>
    <a href="/" {...stylex.attrs(styles.logoLink)}>
      {SITE_TITLE}
      <span aria-hidden="true" {...stylex.attrs(styles.cursor)} />
    </a>
    <div {...stylex.attrs(styles.links)}>
      <HeaderLink aria-label="Home" href="/">
        ~
      </HeaderLink>
      <HeaderLink aria-label="Blog" href="/blog">
        ~/blog
      </HeaderLink>
    </div>
    <div {...stylex.attrs(styles.tools)}>
      <LifeToggle />
      <ThemeToggle />
      <SocialLinks hideOnMobile linkColor="text" />
    </div>
  </nav>
</header>
