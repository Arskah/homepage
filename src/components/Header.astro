---
import * as stylex from "@stylexjs/stylex";

import { SITE_TITLE } from "../consts";
import { styles } from "./Header.stylex";
import HeaderLink from "./HeaderLink.astro";
import SocialLinks from "./SocialLinks.astro";
---

<header {...stylex.attrs(styles.header)}>
  <nav {...stylex.attrs(styles.nav)}>
    <a href="/" {...stylex.attrs(styles.logoLink)}>
      <h2 {...stylex.attrs(styles.h2)}>{SITE_TITLE}</h2>
    </a>
    <div {...stylex.attrs(styles.links)}>
      <HeaderLink aria-label="Home" href="/">
        ~
      </HeaderLink>
      <HeaderLink aria-label="Blog" href="/blog">
        ~/blog
      </HeaderLink>
    </div>
    <SocialLinks
      hideOnMobile
      linkColor="black"
      style={styles.socialCentering}
    />
  </nav>
</header>
